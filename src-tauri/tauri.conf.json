{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A.I.D.P",
  "version": "0.1.0-rc.1",
  "identifier": "com.aidp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A.I.D.P",
        "width": 1024,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Arachno-Sapien",
    "homepage": "https://github.com/Arachno-Sapien/A.I.D.P",
    "license": "MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Chat and code with cloud and local AI models",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFOUE2OUUxMUQ3RDM0NkMKUldSc05IMGQ0V21hN3BOZ1BndFN0YWZnc3gxZHl0NnJLWVorcmV6VWZmR3NQYnJpOUFNRzNaYzkK",
      "endpoints": [
        "https://github.com/Arachno-Sapien/A.I.D.P/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
